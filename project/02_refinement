1. 테이블 만들기
```text
#테이블 만들기

CREATE TABLE members (
    member_id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    name VARCHAR(100) NOT NULL,
    email VARCHAR(255) NOT NULL UNIQUE
);

CREATE TABLE purpose (
    purpose_id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    purpose_name VARCHAR(100) NOT NULL
);

CREATE TABLE member_purposes (
    member_purpose_id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    member_id BIGINT NOT NULL
        REFERENCES members (member_id),
    purpose_id BIGINT NOT NULL
        REFERENCES purpose (purpose_id),
    selected_at TIMESTAMPTZ NOT NULL
);

CREATE TABLE goals (
    goal_id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    member_id BIGINT NOT NULL
        REFERENCES members (member_id),
    carbohydrates_g NUMERIC(8, 2) NOT NULL
        CHECK (carbohydrates_g >= 0),
    protein_g NUMERIC(8, 2) NOT NULL
        CHECK (protein_g >= 0),
    fat_g NUMERIC(8, 2) NOT NULL
        CHECK (fat_g >= 0),
    start_date DATE NOT NULL,
    end_date DATE,
    CONSTRAINT goals_date_order
        CHECK (end_date IS NULL OR end_date >= start_date)
);

CREATE TABLE factory (
    factory_id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    factory_name VARCHAR(150) NOT NULL,
    address VARCHAR(500) NOT NULL UNIQUE
);

CREATE TABLE item (
    item_id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    factory_id BIGINT NOT NULL
        REFERENCES factory (factory_id),
    item_name VARCHAR(150) NOT NULL,
    category VARCHAR(100) NOT NULL,
    serving_size NUMERIC(10, 2) NOT NULL
        CHECK (serving_size > 0),
    serving_unit VARCHAR(30) NOT NULL,
    carbohydrates_g NUMERIC(8, 2) NOT NULL
        CHECK (carbohydrates_g >= 0),
    protein_g NUMERIC(8, 2) NOT NULL
        CHECK (protein_g >= 0),
    fat_g NUMERIC(8, 2) NOT NULL
        CHECK (fat_g >= 0)
);

CREATE TABLE subscription (
    subscription_id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    member_id BIGINT NOT NULL
        REFERENCES members (member_id),
    start_date DATE NOT NULL,
    end_date DATE,
    status VARCHAR(30) NOT NULL,
    CONSTRAINT subscription_date_order
        CHECK (end_date IS NULL OR end_date >= start_date)
);

CREATE TABLE subscription_items (
    subscription_id BIGINT NOT NULL
        REFERENCES subscription (subscription_id),
    item_id BIGINT NOT NULL
        REFERENCES item (item_id),
    quantity INTEGER NOT NULL
        CHECK (quantity > 0),
    PRIMARY KEY (subscription_id, item_id)
);

CREATE TABLE shipment (
    shipment_id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    subscription_id BIGINT NOT NULL
        REFERENCES subscription (subscription_id),
    scheduled_date DATE NOT NULL,
    shipped_at TIMESTAMPTZ,
    delivered_at TIMESTAMPTZ,
    status VARCHAR(30) NOT NULL,
    delivery_address VARCHAR(500),
    CONSTRAINT shipment_id_subscription_unique
        UNIQUE (shipment_id, subscription_id)
);

CREATE TABLE shipment_items (
    shipment_id BIGINT NOT NULL,
    subscription_id BIGINT NOT NULL,
    item_id BIGINT NOT NULL,
    quantity INTEGER NOT NULL
        CHECK (quantity > 0),

    PRIMARY KEY (shipment_id, item_id),

    CONSTRAINT shipment_items_shipment_fk
        FOREIGN KEY (shipment_id, subscription_id)
        REFERENCES shipment (shipment_id, subscription_id),

    CONSTRAINT shipment_items_subscription_item_fk
        FOREIGN KEY (subscription_id, item_id)
        REFERENCES subscription_items (subscription_id, item_id)
        
        
);
```

